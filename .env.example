VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=your_meta_pixel_id_here
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=REPLACE_WITH_SERVER_SIDE_SECRET
VITE_APP_ENV=production
APP_URL=https://ripza.gg
GOOGLE_REDIRECT_URI=https://ripza.gg/api/auth/google/callback
VERIFY_CONTINUE_URL=https://ripza.gg
EMAIL_FROM=Ripza <verify@ripza.gg>
# Required by the contact-support and verification email endpoints. Configure
# the real secret in the deployment environment; never expose it as a VITE_ var.
RESEND_API_KEY=re_your_resend_api_key
# Optional. Defaults to EMAIL_FROM (or Ripza <verify@ripza.gg> when unset).
SUPPORT_EMAIL_FROM=Ripza Support <verify@ripza.gg>
SHIP_FROM_NAME=Ripza
# Shared secret sent by Vercel Cron as `Authorization: Bearer …`.
CRON_SECRET=replace_with_a_long_random_secret
