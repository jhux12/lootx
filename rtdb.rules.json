{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        "coins": {
          ".write": false
        },
        "inventory": {
          ".write": false
        }
      }
    },
    "cases": {
      ".read": true,
      ".write": false
    },
    "provablyFairPublic": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        "clientSeed": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "provablyFairSecret": {
      ".read": false,
      ".write": false
    },
    "provablyFairReveals": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "opens": {
      ".read": false,
      ".write": false
    },
    "shipments": {
      ".read": false,
      ".write": false
    }
  }
}
