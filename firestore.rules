rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdminByClaim() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isAdmin() {
      // Admin is claim-only. Never trust Firestore profile fields for authorization.
      return isAdminByClaim();
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userCreateKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'username',
        'usernameLower',
        'createdAt',
        'updatedAt',
        'photoURL',
        'displayName',
        'lastLogin'
      ]);
    }

    function userUpdateKeysAreSafe() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'username',
        'photoURL',
        'updatedAt',
        'lastLogin',
        'displayName',
        'email',
        'usernameLower'
      ]);
    }

    function userProfileCreateIsValid(uid) {
      return request.auth.uid == uid
        && userCreateKeysAreSafe()
        && request.resource.data.uid == uid
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && (!('username' in request.resource.data) || request.resource.data.username is string)
        && (!('usernameLower' in request.resource.data) || request.resource.data.usernameLower is string)
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is int)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is int)
        && (!('lastLogin' in request.resource.data) || request.resource.data.lastLogin is int);
    }

    function userProfileUpdateIsValid(uid) {
      return request.auth.uid == uid
        && userUpdateKeysAreSafe()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).removedKeys().hasOnly([])
        && request.resource.data.diff(resource.data).addedKeys().hasOnly([])
        && request.resource.data.keys().hasOnly(resource.data.keys())
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && (!('username' in request.resource.data) || request.resource.data.username is string)
        && (!('usernameLower' in request.resource.data) || request.resource.data.usernameLower is string)
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is int)
        && (!('lastLogin' in request.resource.data) || request.resource.data.lastLogin is int);
    }

    match /boxes/{boxId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && (userProfileCreateIsValid(uid) || isAdmin());
      allow update: if isSignedIn() && (userProfileUpdateIsValid(uid) || isAdmin());
      allow delete: if false;
    }



    match /users/{uid}/notifications/{notificationId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/inventory/{inventoryId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /users/{uid}/activity/{activityId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if false;
    }

    match /shipments/{shipmentId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if docId != 'plinko' || isAdmin();
      allow write: if isAdmin();
    }

    match /plinkoBoards/{boardId} {
      allow read: if (resource.data == null || resource.data.enabled != false) || isAdmin();
      allow write: if isAdmin();
    }

    match /plinkoPools/{poolId} {
      allow read: if true;
      allow write: if isAdmin();

      match /items/{itemId} {
        allow read: if (resource.data.enabled == true) || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /plinkoDrops/{dropId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /upgraderTargets/{targetId} {
      allow read: if (resource.data.enabled == true) || isAdmin();
      allow write: if isAdmin();
    }

    match /upgradeAttempts/{attemptId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      match /settings/{settingId} {
        allow read: if true;
        allow write: if isAdmin();

        match /xp/{xpDocId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    match /xpShopItems/{itemId} {
      allow read: if resource.data.enabled == true || isAdmin();
      allow write: if isAdmin();
    }

    match /xpRedemptions/{redemptionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }


    match /adminNotifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /coin_packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if false;

      match /users/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /battles/{battleId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /rounds/{roundId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /opens/{openId} {
      allow read, write: if false;
    }

    match /provablyFair/{uid} {
      allow read, write: if false;
    }

    match /provablyFairReveals/{uid}/reveals/{revealId} {
      allow read, write: if false;
    }

    match /supportCases/{caseId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn()
        && (
          isAdmin()
          || (
            resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email
          )
        );
      allow delete: if isAdmin();
    }
  }
}
