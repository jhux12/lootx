rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /boxes/{boxId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn()
        && ((request.auth.uid == uid && !('coins' in request.resource.data)) || isAdmin());
      allow update: if isSignedIn()
        && ((request.auth.uid == uid && request.resource.data.coins == resource.data.coins) || isAdmin());
      allow delete: if false;
    }



    match /users/{uid}/notifications/{notificationId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/inventory/{inventoryId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /shipments/{shipmentId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if docId != 'upgrader' || isAdmin() || !('serverSeed' in resource.data);
      allow write: if isAdmin();
    }

    match /upgraderTargets/{targetId} {
      allow read: if (resource.data.enabled == true) || isAdmin();
      allow write: if isAdmin();
    }

    match /upgradeAttempts/{attemptId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      match /settings/{settingId} {
        allow read: if true;
        allow write: if isAdmin();

        match /xp/{xpDocId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    match /xpShopItems/{itemId} {
      allow read: if resource.data.enabled == true || isAdmin();
      allow write: if isAdmin();
    }

    match /xpRedemptions/{redemptionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }


    match /adminNotifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /coin_packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /battles/{battleId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /rounds/{roundId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /opens/{openId} {
      allow read, write: if false;
    }

    match /provablyFair/{uid} {
      allow read, write: if false;
    }

    match /provablyFairReveals/{uid}/reveals/{revealId} {
      allow read, write: if false;
    }

    match /supportCases/{caseId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn()
        && (
          isAdmin()
          || (
            resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email
          )
        );
      allow delete: if isAdmin();
    }
  }
}
