rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdminByClaim() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isAdmin() {
      return isAdminByClaim();
    }

    function validUsernameLower(value) {
      return value is string && value.matches('^[a-z0-9_]{3,16}$');
    }

    function hasOnlyKeys(data, allowedKeys) {
      return data.keys().hasOnly(allowedKeys);
    }

    function hasField(data, key) {
      return data.keys().hasAny([key]);
    }

    function userProfileCreateKeys() {
      return [
        'uid',
        'email',
        'phoneNumber',
        'username',
        'usernameLower',
        'createdAt',
        'updatedAt',
        'photoURL',
        'displayName',
        'lastLogin',
        'shippingAddress',
        'topPullsPublic'
      ];
    }

    function userProfileUpdateKeys() {
      return [
        'uid',
        'email',
        'phoneNumber',
        'username',
        'usernameLower',
        'createdAt',
        'updatedAt',
        'photoURL',
        'displayName',
        'lastLogin',
        'shippingAddress',
        'topPullsPublic'
      ];
    }

    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/usernames/$(usernameLower))
        && validUsernameLower(usernameLower)
        && hasOnlyKeys(request.resource.data, ['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwnUser(uid) || isAdmin();

      allow create: if isAdmin()
        || (
          isOwnUser(uid)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(request.resource.data, userProfileCreateKeys())
          && request.resource.data.username is string
          && validUsernameLower(request.resource.data.usernameLower)
          && request.resource.data.email is string
        );

      allow update: if isAdmin()
        || (
          isOwnUser(uid)
          && request.resource.data.uid == uid
          && (!hasField(resource.data, 'uid') || request.resource.data.uid == resource.data.uid)
          && (!hasField(resource.data, 'createdAt') || request.resource.data.createdAt == resource.data.createdAt)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userProfileUpdateKeys())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['shippingAddress'])
          && request.resource.data.username is string
          && validUsernameLower(request.resource.data.usernameLower)
          && request.resource.data.email is string
        );

      allow delete: if false;
    }

    match /users/{uid}/notifications/{notificationId} {
      allow read: if isOwnUser(uid) || isAdmin();
      allow create, update, delete: if isOwnUser(uid);
    }

    match /users/{uid}/inventory/{inventoryId} {
      allow read: if isOwnUser(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid}/activity/{activityId} {
      allow read: if isOwnUser(uid) || isAdmin();
      allow create, update: if isOwnUser(uid) || isAdmin();
      allow delete: if false;
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /boxSummaries/{boxId} {
      allow read: if true;
      // Server/Admin SDK synchronization only; public clients cannot write summaries.
      allow write: if false;
    }

    match /boxes/{boxId} {
      allow read: if true;
      allow write: if isAdmin();

      match /versions/{versionId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    match /battles/{battleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coinPackages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coin_packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.uid);
      allow write: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.uid);
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isAdmin()
        || docId == 'bonus'
        || docId == 'bonus-settings'
        || docId == 'stripe'
        || docId == 'stripe-settings'
        || docId == 'economy'
        || docId == 'pullPass'
        || docId == 'upgrader';
      allow write: if isAdmin();
    }

    match /upgraderTargets/{targetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /shipments/{shipmentId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.uid);
      allow write: if isAdmin();
    }

    match /shippingProfiles/{profileId} {
      allow read, write: if isAdmin();
    }

    match /shippingPackages/{packageId} {
      allow read, write: if isAdmin();
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /site/seo {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /polls/{pollId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    match /liveCommunityStories/{storyId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views is int
          && resource.data.views is int
          && request.resource.data.views == resource.data.views + 1
        );
    }

    match /userVotes/{uid}/polls/{pollId} {
      allow read: if isOwnUser(uid) || isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
