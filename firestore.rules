rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /boxes/{boxId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn()
        && ((request.auth.uid == uid && !('coins' in request.resource.data)) || isAdmin());
      allow update: if isSignedIn()
        && ((request.auth.uid == uid && request.resource.data.coins == resource.data.coins) || isAdmin());
      allow delete: if false;
    }

    match /users/{uid}/inventory/{inventoryId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /shipments/{shipmentId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coin_packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /battles/{battleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /opens/{openId} {
      allow read, write: if false;
    }

    match /provablyFair/{uid} {
      allow read, write: if false;
    }

    match /provablyFairReveals/{uid}/reveals/{revealId} {
      allow read, write: if false;
    }
  }
}
